# ---- Server ----
NODE_ENV=development
PORT=3000
# Origin of the frontend (used for CORS + socket.io). In production the server serves the client itself.
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# ---- Database ----
# json     -> single JSON file, zero setup (prototypes)
# sqlite   -> single-file SQL database (small apps)
# postgres -> PostgreSQL server (bigger apps); start one with `npm run db:up`
DB_DRIVER=sqlite
# Relative paths resolve from server/ (the server's working dir), i.e. the repo-root data/ folder
JSON_DB_PATH=../data/db.json
SQLITE_PATH=../data/app.sqlite
DATABASE_URL=postgres://app:app@localhost:5432/app

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Seeded on first start when the users table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin

# Served over HTTPS? Controls Secure cookies + HSTS. Defaults to true when NODE_ENV=production.
# Set to false only if you deploy on plain http:// (not recommended beyond testing).
# HTTPS_ONLY=true

# ---- Docker compose only ----
# Public origin of the deployed app (used for CORS / socket.io)
# PUBLIC_URL=http://localhost:3000
# APP_PORT=3000
# 127.0.0.1 when a reverse proxy on the same host handles HTTPS
# APP_BIND=0.0.0.0
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=app
